{
  "name": "@kobecuppens/react-feedback",
  "version": "0.2.0",
  "description": "Drop-in feedback & roadmap board for React (DOM). Fully themeable with CSS variables, class slots and component overrides.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KCuppens/react-native-feedback.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/KCuppens/react-native-feedback#readme",
  "bugs": "https://github.com/KCuppens/react-native-feedback/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "rnf-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "feedback",
    "roadmap",
    "feature-requests",
    "voting"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@kobecuppens/feedback-core": "0.2.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4"
  }
}
