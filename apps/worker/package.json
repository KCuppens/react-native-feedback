{
  "name": "@feedback/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply feedback-dev --local",
    "db:migrate:remote": "wrangler d1 migrations apply feedback --env production --remote",
    "project:create": "node scripts/create-project.mjs"
  },
  "dependencies": {
    "@kobecuppens/feedback-core": "0.2.0",
    "hono": "^4.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250920.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^3.2.7",
    "vitest": "^3.2.4",
    "wrangler": "^4.40.0"
  }
}
